const http = require('http');

const PORT = 3000;

let courses = [
    {

        id: 1,
        name: 'Data Structures',
        code: '25CS301',
        department: 'CSE DS'
    },
    {
        id: 2,
        name: 'Operating Systems',
        code: '25CS302',
        department: 'CSE DS'
    },
    {
        id: 3,
        name: 'OOP',
        code: '25CS303',
        department: 'CSE DS'
    }
];

const server = http.createServer((req, res) => {

    console.log(`Request received: ${req.method} ${req.url}`);

    res.setHeader('Content-Type', 'text/plain');

    if (req.method === 'GET' && req.url === '/data') {
        res.statusCode = 200;
        res.end(JSON.stringify(courses));
    }
    else if (req.method === 'POST' && req.url === '/data') {

        let body = '';

        req.on('data', chunk => {
            body += chunk;
        });

        req.on('end', () => {
            const course = JSON.parse(body);

            course.id = courses.length + 1;
            courses.push(course);

            res.statusCode = 201;
            res.end('Course added successfully');
        });
    }

    else if (req.method === 'PUT' && req.url.startsWith('/data/')) {

        const id = Number(req.url.split('/')[2]);

        let body = '';

        req.on('data', chunk => {
            body += chunk;
        });

        req.on('end', () => {
            const course = courses.find(c => c.id === id);

            if (course) {
                const updatedCourse = JSON.parse(body);

                course.name = updatedCourse.name;
                course.code = updatedCourse.code;
                course.department = updatedCourse.department;

                res.statusCode = 200;
                res.end('Course updated successfully');
            }
            else {
                res.statusCode = 404;
                res.end('Course not found');
            }
        });
    }

    else if (req.method === 'DELETE' && req.url.startsWith('/data/')) {

        const id = Number(req.url.split('/')[2]);

        const index = courses.findIndex(c => c.id === id);

        if (index !== -1) {
            courses.splice(index, 1);

            res.statusCode = 200;
            res.end('Course deleted successfully');
        }
        else {
            res.statusCode = 404;
            res.end('Course not found');
        }
    }

    else {
        res.statusCode = 404;
        res.end('Route not found');
    }

});

server.listen(PORT, () => {
    console.log(`Server running at http://localhost:${PORT}`);
});
